# Скопируй этот файл в .env и подставь свои значения.

# URL бэкенда PocketBase. При переезде на другой хостинг меняется только это.
# Примеры:
#   https://anigurt-backend.onrender.com   (старый Render)
#   https://api.example.com                 (свой VPS / Cloudflare Tunnel)
VITE_POCKETBASE_URL=https://anigurt-backend.onrender.com

# Базовый URL Shikimori API (живой домен — shikimori.io).
VITE_SHIKIMORI_URL=https://shikimori.io

# Контактный email для заголовка User-Agent (требование Shikimori API).
VITE_CONTACT_EMAIL=you@example.com

# Домен плеера Kodik (виджет find-player). Kodik периодически меняет домены —
# если плеер отвалится, подставь сюда новый рабочий домен.
VITE_KODIK_PLAYER_URL=https://kodikplayer.com
# Токен Kodik API (для find-player не нужен; оставлен на будущее).
VITE_KODIK_API_KEY=
